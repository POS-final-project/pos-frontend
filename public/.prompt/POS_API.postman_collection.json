            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/products/{{productId}}?shopId={{shopId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "products", "{{productId}}"],
              "query": [{ "key": "shopId", "value": "{{shopId}}" }]
            }
          }
        },
        {
          "name": "Restock (Stock In)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) pm.collectionVariables.set('inventoryId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shop_id\": \"{{shopId}}\",\n  \"product_variant_id\": \"{{variantId}}\",\n  \"qty\": 50,\n  \"cost_price\": 2500,\n  \"note\": \"Restock dari supplier\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/restock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "restock"]
            }
          }
        },
        {
          "name": "Adjustment Out (Stock Out)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shop_id\": \"{{shopId}}\",\n  \"product_variant_id\": \"{{variantId}}\",\n  \"qty\": 5,\n  \"note\": \"Barang rusak/expired\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/adjustment-out",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "adjustment-out"]
            }
          }
        },
        {
          "name": "Set Low Stock Threshold",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"low_stock_threshold\": 10\n}"
            },

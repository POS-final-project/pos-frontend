    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true,
                  "description": "Cari nama produk"
                },
                { "key": "categoryId", "value": "", "disabled": true },
                { "key": "isActive", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) {",
                  "  pm.collectionVariables.set('productId', json.data.id);",
                  "  if (json.data.variants && json.data.variants.length > 0) {",
                  "    pm.collectionVariables.set('variantId', json.data.variants[0].id);",
                  "  }",
                  "  pm.test('Produk berhasil dibuat', () => pm.response.to.have.status(201));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "type": "text", "value": "Aqua 600ml" },
                {
                  "key": "description",
                  "type": "text",
                  "value": "Air mineral 600ml"
                },
                {
                  "key": "category_id",
                  "type": "text",
                  "value": "{{categoryId}}"
                },
                {
                  "key": "variants[0][name]",
                  "type": "text",
                  "value": "Default"
                },
                {
                  "key": "variants[0][sku]",
                  "type": "text",
                  "value": "AQU-600-DEFAULT"
                },
                {
                  "key": "variants[0][price]",
                  "type": "text",
                  "value": "3000"
                },
                {
                  "key": "variants[0][image]",
                  "type": "file",
                  "src": "",
                  "description": "Pilih file gambar variant (jpeg/png/webp, maks 2MB)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
